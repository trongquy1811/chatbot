# ========================================================
# AGENT HARNESS CHATBOT CONFIGURATION TEMPLATE
# Sao chép file này thành .env và điền các giá trị thực tế.
# LƯU Ý: Không commit file .env chứa khóa thật lên Git/GitHub!
# ========================================================

# Khóa API Google Gemini (AI LLM, Vision, Embeddings)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Access Token xác thực API (Tối thiểu 24 ký tự mỗi token)
# Map chuỗi Bearer Token sang định danh người dùng (User ID)
# Định dạng JSON: {"<token_24_chars_min>": "<user_identity>"}
API_KEYS_JSON={"sec_tok_0123456789abcdef0123456789": "demo_user"}

# Cơ sở dữ liệu quan hệ PostgreSQL (Lưu trữ User, Hội thoại, Tin nhắn, Memory)
# Chạy local SQLite: sqlite:///./data/docanalyzer.db
# Chạy Docker Compose: postgresql+psycopg://docanalyzer:mypassword@postgres:5432/docanalyzer
DATABASE_URL=sqlite:///./data/docanalyzer.db
POSTGRES_PASSWORD=mypassword

# Qdrant Vector Store (Semantic Search & Vector Memory)
# Để trống QDRANT_URL để sử dụng lưu trữ local file (/app/data/qdrant)
# Docker Compose: http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_v1
QDRANT_MEMORY_COLLECTION=memories_v1

# Redis Cache & Session Store (Short-term context & Retrieval cache)
# Docker Compose: redis://redis:6379/0
REDIS_URL=

# Thư mục lưu dữ liệu cục bộ
DATA_DIR=data

# Giới hạn & Tham số kiểm soát (Harness Guardrails)
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
MAX_CHUNKS=500
MAX_TOOL_ROUNDS=3
LLM_TIMEOUT=45
MAX_RETRIES=1
OCR_PDF_IMAGES=false

# Cấu hình UI kết nối Backend
API_BASE_URL=http://localhost:8000
